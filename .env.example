# ============================================================
# JobApply environment variables. Copy to .env and fill in.
# NEVER commit your real .env file.
# ============================================================

# --- PRIMARY: Groq (https://console.groq.com/keys - free tier available) ---
AI_PROVIDER=groq
GROQ_API_KEY=gsk_your_key_here
# Optional model overrides (defaults: openai/gpt-oss-120b + openai/gpt-oss-20b fallback)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# --- Alternative backend: Anthropic API (https://console.anthropic.com/) ---
# Only needed if you set llm.backend: api in config.yaml
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Dashboard security (optional) ---
# Require this token in the X-Dashboard-Token header for all /api calls (except /api/health).
# Needed only if you expose the dashboard beyond localhost (e.g. SSH port-forward on a shared host).
# DASHBOARD_TOKEN=change-me-to-a-long-random-string
