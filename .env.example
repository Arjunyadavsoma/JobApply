# ============================================================
# JobApply environment variables. Copy to .env and fill in.
# NEVER commit your real .env file.
# ============================================================

# --- PRIMARY: Groq (https://console.groq.com/keys - free tier available) ---
AI_PROVIDER=groq
GROQ_API_KEY=gsk_your_key_here
# Optional model overrides (defaults: openai/gpt-oss-120b + openai/gpt-oss-20b fallback)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# --- Alternative backend: Anthropic API (https://console.anthropic.com/) ---
# Only needed if you set llm.backend: api in config.yaml
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Dashboard security (optional) ---
# Require this token in the X-Dashboard-Token header for all /api calls (except health endpoints).
# Needed only if you expose the dashboard beyond localhost (e.g. SSH port-forward on a shared host).
# DASHBOARD_TOKEN=change-me-to-a-long-random-string

# --- Credential vault master key (optional, Phase 19) ---
# Secrets stored via System -> Credential Manager are AES-256-GCM encrypted with this key.
# If unset, a key is generated once at data/.credentials.key (chmod 0600). BACK IT UP —
# without it, vault contents are unrecoverable by design. Base64 of exactly 32 bytes.
# Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# JOBAGENT_MASTER_KEY=
