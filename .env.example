# ============================================================
# JobApply environment variables. Copy to .env and fill in.
# NEVER commit your real .env file.
# ============================================================

# --- PRIMARY: Groq (https://console.groq.com/keys - free tier available) ---
AI_PROVIDER=groq
GROQ_API_KEY=gsk_your_key_here
# MULTIPLE KEYS (recommended): comma-separated list, rotated automatically on every
# call. A rate-limited key rests (retry-after) while the others keep working —
# this is the practical fix for Groq's free-tier 429s. Duplicates vs
# GROQ_API_KEY / the credential vault are removed automatically.
# GROQ_API_KEYS=gsk_key_one,gsk_key_two,gsk_key_three
# Optional model overrides (defaults: openai/gpt-oss-120b + openai/gpt-oss-20b fallback)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# --- Provider fallback chain (Phase 20, optional) ---
# When Groq can't serve a call (all keys cooling/disabled, provider down, or no
# Groq key), it retries against these providers in order. Each has its own key
# pool with the same rotation semantics + its own circuit breaker.
# Presets: openrouter, openai, together, fireworks, gemini, deepseek, mistral,
# ollama, lmstudio (the last two are local + keyless). Custom endpoints go in
# llm.fallback_providers in config.yaml.
# LLM_FALLBACK_PROVIDERS=openrouter,together
# Keys per provider (multi + single, deduped automatically; vault credentials
# with the matching provider name also join):
# OPENROUTER_API_KEYS=sk-or-key-one,sk-or-key-two
# OPENROUTER_API_KEY=sk-or-key-one
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct   # optional per-provider model
# TOGETHER_API_KEY=...  OPENAI_API_KEY=...  GEMINI_API_KEY=...  DEEPSEEK_API_KEY=...
# MISTRAL_API_KEY=...   FIREWORKS_API_KEY=...

# --- Alternative backend: Anthropic API (https://console.anthropic.com/) ---
# Only needed if you set llm.backend: api in config.yaml
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Dashboard security (optional) ---
# Require this token in the X-Dashboard-Token header for all /api calls (except health endpoints).
# Needed only if you expose the dashboard beyond localhost (e.g. SSH port-forward on a shared host).
# DASHBOARD_TOKEN=change-me-to-a-long-random-string

# --- Credential vault master key (optional, Phase 19) ---
# Secrets stored via System -> Credential Manager are AES-256-GCM encrypted with this key.
# If unset, a key is generated once at data/.credentials.key (chmod 0600). BACK IT UP —
# without it, vault contents are unrecoverable by design. Base64 of exactly 32 bytes.
# Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# JOBAGENT_MASTER_KEY=
